---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const { title = 'Il Momento Ristorante', description = 'Ristorante a Velletri — cucina romana All You Can Eat a 20€. Prenota direttamente senza commissioni.' } = Astro.props;
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="Il Momento ristorante, ristorante Velletri, cucina romana, All You Can Eat, Castelli Romani" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <style is:global>
    /* ===== DESIGN SYSTEM ===== */
    :root {
      --color-primary: #C67B4B;
      --color-primary-dark: #A85F35;
      --color-secondary: #2F3E2B;
      --color-secondary-light: #3F5239;
      --color-accent: #C9A96E;
      --color-accent-light: #D4BA8A;
      --color-bg: #FFFAF5;
      --color-bg-alt: #F5EDE0;
      --color-text: #2C2416;
      --color-text-light: #6B5E4F;
      --color-white: #FFFFFF;
      --color-black: #1A1008;
      --color-gold: #C9A96E;
      --color-whatsapp: #1fa855;

      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;

      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 16px;
      --radius-xl: 24px;

      --space-xs: 0.5rem;
      --space-sm: 1rem;
      --space-md: 1.5rem;
      --space-lg: 2rem;
      --space-xl: 3rem;
      --space-2xl: 4rem;
      --space-3xl: 6rem;

      --container: 1200px;
      --transition-fast: 150ms ease;
      --transition-base: 250ms ease;
      --transition-slow: 400ms ease;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      color: var(--color-text);
      background: var(--color-bg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      line-height: 1.2;
    }
    h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700; }
    h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 600; }
    h3 { font-size: clamp(1.25rem, 2.5vw, 1.75rem); font-weight: 600; }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    .container {
      width: 100%;
      max-width: var(--container);
      margin: 0 auto;
      padding: 0 var(--space-md);
    }

    /* ===== ANTI-FLASH: CSS hides animated elements ===== */
    .hero__eyebrow    { opacity: 0; transform: translateY(20px); }
    .hero__title      { opacity: 0; }
    .hero__subtitle   { opacity: 0; transform: translateY(20px); }
    .hero__actions    { opacity: 0; }
    .hero__actions .btn { opacity: 0; transform: translateY(10px); }
    .reveal           { opacity: 0; }
    .menu__card       { opacity: 0; transform: translateY(30px); }
    .gallery__item    { opacity: 0; }
    .review-card      { opacity: 0; transform: translateY(20px); }
    .chef__image-wrapper { opacity: 0; }

    /* ===== BUTTONS ===== */
    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.875rem 2rem;
      font-family: var(--font-body); font-weight: 600; font-size: 0.95rem;
      border-radius: var(--radius-md);
      cursor: pointer; border: none;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }
    .btn:hover { transform: translateY(-2px); }
    .btn--primary {
      background: var(--color-primary); color: var(--color-white);
      box-shadow: 0 4px 16px rgba(198, 123, 75, 0.35);
    }
    .btn--primary:hover { box-shadow: 0 6px 20px rgba(198, 123, 75, 0.5); }
    .btn--secondary {
      background: var(--color-secondary); color: var(--color-white);
      box-shadow: 0 4px 16px rgba(47, 62, 43, 0.35);
    }
    .btn--outline-light {
      border: 2px solid rgba(255,255,255,0.7);
      color: var(--color-white);
      background: rgba(44,36,22,0.4);
    }
    .btn--outline-light:hover { background: rgba(255,255,255,0.15); border-color: var(--color-white); }
    .btn--whatsapp {
      background: var(--color-whatsapp); color: var(--color-white);
      box-shadow: 0 4px 16px rgba(31,168,85,0.35);
    }
    .btn--instagram {
      background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
      color: var(--color-white);
    }

    /* ===== NAVBAR ===== */
    .navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      padding: 1rem 0;
      transition: background var(--transition-base), box-shadow var(--transition-base);
    }
    .navbar.scrolled {
      background: rgba(255, 250, 245, 0.92);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 2px 20px rgba(44,36,22,0.08);
    }
    .navbar__inner {
      display: flex; align-items: center; justify-content: space-between;
      max-width: var(--container); margin: 0 auto; padding: 0 var(--space-md);
    }
    .navbar__logo {
      font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
      color: var(--color-white);
      transition: color var(--transition-base);
    }
    .scrolled .navbar__logo { color: var(--color-text); }
    .navbar__links { display: flex; gap: 2rem; align-items: center; list-style: none; }
    .navbar__links a {
      font-size: 0.9rem; font-weight: 500; color: var(--color-white);
      transition: color var(--transition-fast), opacity var(--transition-fast);
    }
    .navbar__links a:hover { opacity: 0.8; }
    .scrolled .navbar__links a { color: var(--color-text); }
    .navbar__cta { padding: 0.5rem 1.25rem; font-size: 0.85rem; }
    .navbar__burger {
      display: none; background: none; border: none; cursor: pointer;
      color: var(--color-white); padding: 0.5rem;
    }
    .scrolled .navbar__burger { color: var(--color-text); }
    .navbar__burger span {
      display: block; width: 22px; height: 2px;
      background: currentColor; margin: 0;
      transition: transform 0.3s ease, opacity 0.2s ease;
      transform-origin: center;
    }

    /* ===== HERO ===== */
    .hero {
      position: relative; min-height: 100vh; display: flex; align-items: center;
      overflow: hidden;
      background: var(--color-secondary);
    }
    .hero__bg {
      position: absolute; inset: 0; z-index: 0;
    }
    .hero__bg img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .hero__overlay {
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(47,62,43,0.85) 0%, rgba(44,36,22,0.4) 100%);
      z-index: 1;
    }
    .hero__content {
      position: relative; z-index: 2;
      max-width: 800px; padding: var(--space-2xl) var(--space-md);
    }
    .hero__eyebrow {
      font-family: var(--font-body); font-size: 0.85rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.15em;
      color: var(--color-accent); margin-bottom: var(--space-md);
    }
    .hero__title {
      color: var(--color-white); margin-bottom: var(--space-md);
    }
    .hero__title-mask {
      display: block; overflow: hidden;
    }
    .hero__subtitle {
      font-size: clamp(1rem, 2vw, 1.2rem); color: rgba(255,255,255,0.85);
      margin-bottom: var(--space-xl); max-width: 550px;
    }
    .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .hero__ratings {
      display: flex; gap: var(--space-xl); margin-top: var(--space-xl);
      align-items: center;
    }
    .hero__ratings-item {
      display: flex; flex-direction: column; align-items: center;
    }
    .hero__ratings-number {
      font-family: var(--font-display); font-size: 1.5rem;
      font-weight: 700; color: var(--color-accent);
    }
    .hero__ratings-label {
      font-size: 0.75rem; color: rgba(255,255,255,0.7);
      text-transform: uppercase; letter-spacing: 0.05em;
    }

    /* ===== SECTION COMMON ===== */
    section {
      padding: var(--space-3xl) 0;
      position: relative;
    }
    .section__header {
      text-align: center; margin-bottom: var(--space-2xl);
    }
    .section__eyebrow {
      font-family: var(--font-body); font-size: 0.85rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.15em;
      color: var(--color-primary); margin-bottom: var(--space-sm);
    }
    .section__title { margin-bottom: var(--space-sm); }
    .section__subtitle {
      color: var(--color-text-light); font-size: 1.05rem;
      max-width: 600px; margin: 0 auto;
    }

    /* ===== CHI SIAMO ===== */
    .chisiamo {
      background: var(--color-bg);
    }
    .chisiamo__grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl);
      align-items: center;
    }
    .chisiamo__image {
      border-radius: var(--radius-lg); overflow: hidden;
      box-shadow: 0 8px 40px rgba(44,36,22,0.12);
    }
    .chisiamo__content h2 { margin-bottom: var(--space-md); }
    .chisiamo__content p { color: var(--color-text-light); margin-bottom: var(--space-md); line-height: 1.8; }
    .chisiamo__stats {
      display: flex; gap: var(--space-xl); margin-top: var(--space-lg);
    }
    .chisiamo__stat-number {
      font-family: var(--font-display); font-size: 2rem;
      font-weight: 700; color: var(--color-primary);
    }
    .chisiamo__stat-label { font-size: 0.85rem; color: var(--color-text-light); }

    /* ===== MENU ===== */
    .menu {
      background: var(--color-secondary);
      color: var(--color-white);
    }
    .menu .section__eyebrow { color: var(--color-accent); }
    .menu .section__subtitle { color: rgba(255,255,255,0.7); }
    .menu__grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-lg);
    }
    .menu__card {
      background: rgba(47, 62, 43, 0.55);
      border: 1px solid rgba(201, 169, 110, 0.25);
      border-radius: var(--radius-lg); padding: var(--space-lg);
      transition: transform var(--transition-base), border-color var(--transition-base);
    }
    @supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
      .menu__card {
        background: rgba(255, 255, 255, 0.09);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(201, 169, 110, 0.2);
      }
    }
    .menu__card:hover {
      transform: translateY(-4px);
      border-color: rgba(201, 169, 110, 0.45);
    }
    .menu__card--featured {
      grid-row: span 2;
      border-color: var(--color-accent);
      background: rgba(201, 169, 110, 0.15);
    }
    .menu__card-icon { font-size: 2rem; margin-bottom: var(--space-sm); }
    .menu__card-title {
      font-family: var(--font-display); font-size: 1.35rem;
      margin-bottom: var(--space-sm); color: var(--color-white);
    }
    .menu__card-desc {
      font-size: 0.9rem; color: rgba(255,255,255,0.72); line-height: 1.7;
      margin-bottom: var(--space-md);
    }
    .menu__card-price {
      font-size: 0.85rem; font-weight: 600; color: var(--color-accent);
      text-transform: uppercase; letter-spacing: 0.05em;
    }
    .menu__card-badge {
      display: inline-block; font-size: 0.75rem; font-weight: 600;
      padding: 0.25rem 0.75rem; border-radius: 20px;
      background: var(--color-accent); color: var(--color-secondary);
      text-transform: uppercase; margin-bottom: var(--space-sm);
    }

    /* ===== GALLERIA ===== */
    .gallery { background: var(--color-bg); }
    .gallery__grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      grid-template-rows: 280px 200px 280px; gap: var(--space-sm);
    }
    .gallery__item {
      border-radius: var(--radius-md); overflow: hidden; cursor: pointer;
      position: relative;
    }
    .gallery__item img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform var(--transition-slow);
    }
    .gallery__item:hover img { transform: scale(1.05); }
    .gallery__item:nth-child(1) { grid-column: span 2; grid-row: span 1; }
    .gallery__item:nth-child(2) { grid-column: span 1; grid-row: span 2; }
    .gallery__item:nth-child(3) { grid-column: span 1; grid-row: span 1; }
    .gallery__item:nth-child(4) { grid-column: span 1; grid-row: span 1; }
    .gallery__item:nth-child(5) { grid-column: span 2; grid-row: span 1; }
    .gallery__item:nth-child(6) { grid-column: span 1; grid-row: span 1; }

    /* ===== REVIEWS ===== */
    .reviews {
      background: var(--color-bg-alt);
    }
    .reviews__grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-lg);
    }
    .review-card {
      background: var(--color-white); border-radius: var(--radius-lg);
      padding: var(--space-lg); box-shadow: 0 4px 16px rgba(44,36,22,0.06);
    }
    .review-card__stars { color: var(--color-accent); font-size: 1.1rem; margin-bottom: var(--space-sm); }
    .review-card__text { color: var(--color-text-light); font-size: 0.95rem; line-height: 1.7; margin-bottom: var(--space-md); }
    .review-card__author { font-weight: 600; font-size: 0.9rem; }
    .review-card__author span { color: var(--color-text-light); font-weight: 400; font-size: 0.8rem; }

    /* ===== CTA CENTRALE ===== */
    .cta-section {
      background: linear-gradient(135deg, var(--color-secondary) 0%, #1A2A17 100%);
      color: var(--color-white); text-align: center;
    }
    .cta-section h2 { margin-bottom: var(--space-md); }
    .cta-section p {
      color: rgba(255,255,255,0.8); font-size: 1.1rem;
      max-width: 600px; margin: 0 auto var(--space-xl);
    }
    .cta-section__buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    /* ===== MAPPA ===== */
    .map-section { padding: 0; }
    #map { height: 400px; width: 100%; }
    .map__button {
      display: flex; justify-content: center; padding: var(--space-md);
      background: var(--color-bg-alt);
    }

    /* ===== CONTATTI ===== */
    .contacts { background: var(--color-bg); }
    .contacts__grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl);
    }
    .contacts__info { display: flex; flex-direction: column; gap: var(--space-lg); }
    .contacts__item { display: flex; gap: var(--space-sm); align-items: flex-start; }
    .contacts__item-icon {
      flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
      background: var(--color-secondary); color: var(--color-accent);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .contacts__item-title { font-weight: 600; margin-bottom: 2px; }
    .contacts__item-text { color: var(--color-text-light); font-size: 0.9rem; }

    .contacts__form {
      background: var(--color-white); padding: var(--space-lg);
      border-radius: var(--radius-lg); box-shadow: 0 4px 16px rgba(44,36,22,0.06);
    }
    .contacts__form h3 { margin-bottom: var(--space-md); }
    .form__group { margin-bottom: var(--space-md); }
    .form__label { display: block; font-weight: 500; margin-bottom: 0.35rem; font-size: 0.9rem; }
    .form__input, .form__select, .form__textarea {
      width: 100%; padding: 0.75rem 1rem;
      font-family: var(--font-body); font-size: 0.95rem;
      border: 1px solid #ddd; border-radius: var(--radius-md);
      background: var(--color-bg); transition: border-color var(--transition-fast);
    }
    .form__input:focus, .form__select:focus, .form__textarea:focus {
      outline: none; border-color: var(--color-primary);
    }
    .form__textarea { min-height: 100px; resize: vertical; }
    .form__note { font-size: 0.8rem; color: var(--color-text-light); margin-top: var(--space-sm); }

    /* ===== FOOTER ===== */
    .footer {
      background: var(--color-black); color: rgba(255,255,255,0.7);
      padding: var(--space-2xl) 0;
    }
    .footer__grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-xl);
    }
    .footer__brand-name {
      font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
      color: var(--color-accent); margin-bottom: var(--space-sm);
    }
    .footer__brand-desc { font-size: 0.9rem; line-height: 1.7; }
    .footer__col-title {
      font-weight: 600; color: var(--color-white);
      margin-bottom: var(--space-md); font-size: 0.95rem;
    }
    .footer__links { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .footer__links a { font-size: 0.9rem; transition: color var(--transition-fast); }
    .footer__links a:hover { color: var(--color-accent); }
    .footer__social { display: flex; gap: 1rem; margin-top: var(--space-md); }
    .footer__social a {
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(255,255,255,0.1); display: flex; align-items: center;
      justify-content: center; transition: background var(--transition-fast);
    }
    .footer__social a:hover { background: var(--color-accent); }
    .footer__bottom {
      margin-top: var(--space-xl); padding-top: var(--space-lg);
      border-top: 1px solid rgba(255,255,255,0.1);
      text-align: center; font-size: 0.85rem;
    }

    /* ===== WHATSAPP FLOAT ===== */
    .whatsapp-float {
      position: fixed; bottom: 24px; right: 24px; z-index: 999;
      width: 60px; height: 60px; background: var(--color-whatsapp);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 8px 25px rgba(31,168,85,0.4); transition: transform 0.2s;
    }
    .whatsapp-float:hover { transform: scale(1.1); }

    /* ===== LIGHTBOX ===== */
    .lightbox {
      position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,0.92);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity var(--transition-base);
    }
    .lightbox.open { opacity: 1; pointer-events: auto; }
    .lightbox img { max-width: 90vw; max-height: 85vh; border-radius: var(--radius-md); }
    .lightbox__close {
      position: absolute; top: 20px; right: 20px;
      background: none; border: none; color: var(--color-white);
      font-size: 2rem; cursor: pointer; opacity: 0.7; transition: opacity var(--transition-fast);
    }
    .lightbox__close:hover { opacity: 1; }
    .lightbox__nav {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: rgba(255,255,255,0.15); border: none; color: var(--color-white);
      font-size: 2rem; cursor: pointer; padding: 1rem; border-radius: 50%;
      opacity: 0.7; transition: opacity var(--transition-fast);
    }
    .lightbox__nav:hover { opacity: 1; }
    .lightbox__prev { left: 20px; }
    .lightbox__next { right: 20px; }

    /* ===== INSTAGRAM BANNER ===== */
    .instagram-banner {
      background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
      padding: var(--space-xl) 0; text-align: center;
    }
    .instagram-banner h3 { color: var(--color-white); margin-bottom: var(--space-sm); }
    .instagram-banner p { color: rgba(255,255,255,0.85); margin-bottom: var(--space-md); }

    /* ===== MOBILE ===== */
    @media (max-width: 768px) {
      .chisiamo__grid { grid-template-columns: 1fr; }
      .gallery__grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto; gap: var(--space-xs);
      }
      .gallery__item:nth-child(n) { grid-column: span 1; grid-row: span 1; }
      .contacts__grid { grid-template-columns: 1fr; }
      .hero__ratings { gap: var(--space-md); }
      .menu__card--featured { grid-row: span 1; }
      .navbar__burger { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; width: 40px; height: 40px; }
      .navbar__burger span {
        display: block; width: 22px; height: 2px;
        background: currentColor; margin: 0;
        transition: transform 0.3s ease, opacity 0.2s ease;
        transform-origin: center;
      }
      .navbar__burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .navbar__burger.open span:nth-child(2) { opacity: 0; }
      .navbar__burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .navbar__links {
        position: absolute; top: 100%; left: 0; right: 0;
        background: rgba(255, 250, 245, 0.98);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        flex-direction: column; padding: 0 var(--space-md);
        gap: 0;
        max-height: 0; overflow: hidden; opacity: 0;
        transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.3s ease;
      }
      .navbar__links.open {
        max-height: 400px; opacity: 1;
        padding: var(--space-md);
      }
      .navbar__links a:not(.btn) {
        color: var(--color-text);
        display: block; padding: 0.6rem 0;
        border-bottom: 1px solid rgba(44,36,22,0.06);
      }
      .navbar__links li:last-child a:not(.btn) { border-bottom: none; }
      .navbar.scrolled .navbar__links { background: var(--color-bg); }
    }

    @media (max-width: 480px) {
      .hero__actions { flex-direction: column; }
      .gallery__grid { grid-template-columns: 1fr 1fr; }
      .reviews__grid { grid-template-columns: 1fr; }
    }

    /* ===== UTILITY ===== */
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
      border: 0;
    }
  </style>

  <!-- Safety net: noscript fallback -->
  <noscript>
    <style>
      .reveal, .hero__eyebrow, .hero__title, .hero__subtitle, .hero__actions,
      .hero__actions .btn, .menu__card, .gallery__item, .review-card,
      .chef__image-wrapper { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>
</head>
<body>
  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox__close" id="lightboxClose" aria-label="Chiudi">&times;</button>
    <button class="lightbox__prev lightbox__nav" id="lightboxPrev" aria-label="Precedente">&#8249;</button>
    <button class="lightbox__next lightbox__nav" id="lightboxNext" aria-label="Successiva">&#8250;</button>
    <img src="" alt="" id="lightboxImg" />
  </div>

  <!-- CDN Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.3.13/dist/lenis.min.js" defer></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

  <script is:inline>
    /* ===== ANIMATIONS & INTERACTIVITY ===== */

    // =============================================
    // 1. DEPENDENCY-FREE FUNCTIONS (no GSAP needed)
    // =============================================

    // Mobile menu toggle
    function initMobileMenu() {
      const burger = document.getElementById('burger');
      const navLinks = document.getElementById('navLinks');
      if (!burger || !navLinks) return;
      burger.addEventListener('click', () => {
        navLinks.classList.toggle('open');
        burger.classList.toggle('open');
      });
      // Close on link click
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          burger.classList.remove('open');
        });
      });
    }

    // Counters with IntersectionObserver
    function initCounters() {
      const counters = document.querySelectorAll('[data-counter]');
      if (!counters.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          const target = parseInt(el.dataset.counter);
          const duration = parseInt(el.dataset.duration || 2000);
          const decimals = parseInt(el.dataset.decimals || 0);
          const suffix = el.dataset.suffix || '';
          const prefix = el.dataset.prefix || '';
          const start = performance.now();

          function update(now) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            // easeOutCubic
            const eased = 1 - Math.pow(1 - progress, 3);
            const val = (target * eased).toFixed(decimals);
            el.textContent = prefix + val + suffix;
            if (progress < 1) requestAnimationFrame(update);
          }
          requestAnimationFrame(update);
          observer.unobserve(el);
        });
      }, { threshold: 0.3 });

      counters.forEach(c => observer.observe(c));
    }

    // Form to WhatsApp redirect
    function initForm() {
      const form = document.getElementById('contactForm');
      if (!form) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = form.querySelector('[name="name"]').value.trim();
        const phone = form.querySelector('[name="phone"]').value.trim();
        const guests = form.querySelector('[name="guests"]').value;
        const date = form.querySelector('[name="date"]').value;
        const time = form.querySelector('[name="time"]').value;
        const message = form.querySelector('[name="message"]').value.trim();

        let text = `Ciao Il Momento!%0A%0A`;
        text += `Sono ${encodeURIComponent(name)}%0A`;
        text += `Telefono: ${encodeURIComponent(phone)}%0A`;
        if (guests) text += `Persone: ${guests}%0A`;
        if (date) text += `Data: ${date}%0A`;
        if (time) text += `Orario: ${time}%0A`;
        if (message) text += `%0A${encodeURIComponent(message)}`;
        text += `%0A%0A(Vorrei prenotare un tavolo)`;

        window.open(`https://wa.me/390652978474?text=${text}`, '_blank');
        form.reset();
      });
    }

    // Lightbox gallery
    function initLightbox() {
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightboxImg');
      const lbClose = document.getElementById('lightboxClose');
      const lbPrev = document.getElementById('lightboxPrev');
      const lbNext = document.getElementById('lightboxNext');
      if (!lb || !lbImg) return;

      const items = Array.from(document.querySelectorAll('[data-gallery]'));
      let currentIndex = 0;

      function open(index) {
        currentIndex = index;
        lbImg.src = items[index].dataset.gallery;
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lb.classList.remove('open');
        document.body.style.overflow = '';
      }

      function prev() {
        currentIndex = (currentIndex - 1 + items.length) % items.length;
        lbImg.src = items[currentIndex].dataset.gallery;
      }

      function next() {
        currentIndex = (currentIndex + 1) % items.length;
        lbImg.src = items[currentIndex].dataset.gallery;
      }

      items.forEach((item, i) => item.addEventListener('click', () => open(i)));
      lbClose.addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      lbPrev.addEventListener('click', prev);
      lbNext.addEventListener('click', next);
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') prev();
        if (e.key === 'ArrowRight') next();
      });
    }

    // Leaflet map
    function initMap() {
      const mapEl = document.getElementById('map');
      if (!mapEl || typeof L === 'undefined') return;

      const lat = 41.6814;
      const lon = 12.7755;

      const map = L.map('map').setView([lat, lon], 15);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19
      }).addTo(map);

      L.marker([lat, lon]).addTo(map)
        .bindPopup('<b>Il Momento ristorante</b><br>Via del Mattatoio, 9<br>00049 Velletri RM')
        .openPopup();
    }

    // =============================================
    // 2. GSAP ANIMATIONS (delayed for CDN load)
    // =============================================
    function initGSAP() {
      if (typeof gsap === 'undefined') {
        console.warn('GSAP not loaded — revealing elements via fallback');
        revealAllFallback();
        return;
      }
      if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

      // Lenis smooth scroll
      let lenis = null;
      if (typeof Lenis !== 'undefined') {
        lenis = new Lenis({ duration: 1.2, smoothWheel: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
        lenis.on('scroll', ScrollTrigger.update);
      }

      // Re-sync ScrollTrigger with Lenis
      gsap.ticker.add((time) => {
        if (lenis) lenis.raf(time * 1000);
      });
      if (lenis) gsap.ticker.lagSmoothing(0);

      // --- Hero: Mask Reveal + Stagger ---
      const heroTL = gsap.timeline({ delay: 0.3 });
      heroTL
        .to('.hero__eyebrow', { y: 0, opacity: 1, duration: 0.8, ease: 'power2.out' })
        .to('.hero__title', { yPercent: 0, opacity: 1, duration: 1.0, ease: 'power4.out' }, '-=0.5')
        .to('.hero__subtitle', { y: 0, opacity: 1, duration: 0.8, ease: 'power2.out' }, '-=0.5')
        .to('.hero__actions', { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.4')
        .to('.hero__actions .btn', { y: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.3');

      // --- Scroll Reveal ---
      gsap.utils.toArray('.reveal').forEach(el => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          onEnter: () => {
            gsap.to(el, { opacity: 1, duration: 0.7, ease: 'power2.out' });
          }
        });
      });

      // --- Menu Stagger ---
      const menuCards = gsap.utils.toArray('.menu__card');
      if (menuCards.length) {
        ScrollTrigger.create({
          trigger: '.menu__grid',
          start: 'top 80%',
          onEnter: () => {
            gsap.to(menuCards, {
              opacity: 1, y: 0, duration: 0.6,
              stagger: 0.12, ease: 'power2.out'
            });
          },
          onLeaveBack: () => {
            gsap.set(menuCards, { opacity: 1, y: 0 });
          }
        });
      }

      // --- Gallery Image Reveal ---
      gsap.utils.toArray('.gallery__item').forEach(el => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          onEnter: () => {
            gsap.to(el, { opacity: 1, duration: 0.5, ease: 'power2.out' });
          }
        });
      });

      // --- Reviews Stagger ---
      const reviewCards = gsap.utils.toArray('.review-card');
      if (reviewCards.length) {
        ScrollTrigger.create({
          trigger: '.reviews__grid',
          start: 'top 80%',
          onEnter: () => {
            gsap.to(reviewCards, {
              opacity: 1, y: 0, duration: 0.5,
              stagger: 0.15, ease: 'power2.out'
            });
          },
          onLeaveBack: () => {
            gsap.set(reviewCards, { opacity: 1, y: 0 });
          }
        });
      }

      // --- Chef Section Pin ---
      const chefSection = document.querySelector('.chisiamo');
      if (chefSection) {
        ScrollTrigger.create({
          trigger: chefSection,
          start: 'top top',
          end: 'bottom bottom',
          pin: '.chisiamo__image',
          pinSpacing: false
        });
      }

      // --- Navbar scroll ---
      ScrollTrigger.create({
        start: 'top -80',
        onEnter: () => document.querySelector('.navbar')?.classList.add('scrolled'),
        onLeaveBack: () => document.querySelector('.navbar')?.classList.remove('scrolled')
      });

      // --- Parallax hero (subtle) ---
      gsap.to('.hero__bg', {
        y: 80,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: 0.5
        }
      });
    }

    function revealAllFallback() {
      const els = document.querySelectorAll(
        '.reveal, .hero__eyebrow, .hero__title, .hero__subtitle, .hero__actions, ' +
        '.hero__actions .btn, .menu__card, .gallery__item, .review-card, .chef__image-wrapper'
      );
      els.forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; });
    }

    // =============================================
    // 3. BOOTSTRAP
    // =============================================
    // Safety net: if GSAP CDN fails, reveal elements after 4s
    setTimeout(() => {
      const hidden = document.querySelector('.hero__title');
      if (hidden && getComputedStyle(hidden).opacity === '0') {
        revealAllFallback();
      }
    }, 4000);

    document.addEventListener('DOMContentLoaded', () => {
      initMobileMenu();
      initCounters();
      initForm();
      initLightbox();
      initMap();
      // Delay GSAP to let CDN scripts load
      setTimeout(initGSAP, 150);
    });
  </script>
</body>
</html>

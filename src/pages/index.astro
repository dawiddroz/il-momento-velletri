            <button type="submit" class="btn btn--primary" style="width:100%; justify-content:center; font-size:1rem; padding:1rem;">
              Invia richiesta su WhatsApp
            </button>
            <p class="form__note">La tua richiesta verrà inviata via WhatsApp. Ti risponderemo in pochi minuti!</p>
          </form>

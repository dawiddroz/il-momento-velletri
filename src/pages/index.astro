---
import BaseLayout from '../layouts/BaseLayout.astro';
/* ═══════════════════════════════════════════════════════
   SITO — IL MOMENTO RISTORANTE (Velletri)
   Dati reali verificati: GMaps 4.5⭐/376 recensioni, tel 06 5297 8474,
   orari mar-dom, Via del Mattatoio 9. Foto Unsplash temporanee.
   ═══════════════════════════════════════════════════════ */
---

<BaseLayout
  title="Il Momento ristorante | Cucina Italiana a Velletri"
  description="Ristorante Il Momento a Velletri: cucina italiana autentica, carbonara al tartufo e piatti della tradizione. Prenota il tuo tavolo direttamente, senza commissioni."
>
  <!-- ===== HERO ===== -->
  <section class="hero" id="home">
    <div class="hero__bg">
      <img
        src="https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=1400&q=85&auto=format&fit=crop"
        alt="Tavola imbandita con cucina italiana"
        onerror="this.src='https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1400&q=85&auto=format&fit=crop'"
      />
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content container">
      <p class="hero__eyebrow reveal">Velletri • Lazio</p>
      <h1 class="hero__title">
        <span class="hero__title-mask">Il Momento ristorante</span>
      </h1>
      <p class="hero__subtitle reveal">
        Cucina autentica, ingredienti di qualità e un'atmosfera che sa di casa. Prenota il tuo tavolo direttamente da qui, senza commissioni.
      </p>
      <div class="hero__actions">
        <a href="#menu" class="btn btn--primary">
          Scopri il Menu
        </a>
        <a href="https://wa.me/390652978474" target="_blank" rel="noopener" class="btn btn--outline-light">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="display:block"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Prenota WhatsApp
        </a>
        <a href="tel:+390652978474" class="btn btn--instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="display:block"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          Chiama 06 5297 8474
        </a>
      </div>
      <!-- STATS: dati reali da Google Maps (verificati) -->
      <div class="hero__ratings">
        <div class="hero__ratings-item">
          <span class="hero__ratings-number" data-counter="4" data-suffix=".5" data-decimals="1">4.5</span>
          <span class="hero__ratings-label">Valutazione Google</span>
        </div>
        <div class="hero__ratings-item">
          <span class="hero__ratings-number" data-counter="376" data-suffix="+" data-decimals="0">376+</span>
          <span class="hero__ratings-label">Recensioni</span>
        </div>
        <div class="hero__ratings-item">
          <span class="hero__ratings-number" data-counter="20" data-suffix="-30€" data-decimals="0">20-30€</span>
          <span class="hero__ratings-label">Prezzo Medio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CHI SIAMO ===== -->
  <section class="chisiamo reveal" id="chisiamo">
    <div class="container">
      <div class="chisiamo__grid">
        <div class="chisiamo__image">
          <img
            src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=700&q=85&auto=format&fit=crop"
            alt="Interno del ristorante"
            onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=700&q=85&auto=format&fit=crop'"
            loading="lazy"
          />
        </div>
        <div class="chisiamo__content">
          <span class="section__eyebrow reveal">La Nostra Storia</span>
          <h2 class="reveal">Passione per la buona cucina</h2>
          <p class="reveal">
            Nel cuore di Velletri, il nostro ristorante porta in tavola i sapori autentici della tradizione italiana.
            Ingredienti freschi, ricette curate e la passione di chi questo mestiere lo ama davvero.
          </p>
          <p class="reveal">
            Ogni piatto racconta la nostra terra: materie prime selezionate ogni giorno e quel tocco
            di calore che solo una tavola italiana sa dare. Vi aspettiamo in Via del Mattatoio, 9.
          </p>
          <div class="chisiamo__stats reveal">
            <div>
              <div class="chisiamo__stat-number" data-counter="4" data-suffix=".5" data-decimals="1">4.5</div>
              <div class="chisiamo__stat-label">Valutazione Google</div>
            </div>
            <div>
              <div class="chisiamo__stat-number" data-counter="376" data-suffix="+">376+</div>
              <div class="chisiamo__stat-label">Recensioni</div>
            </div>
            <div>
              <div class="chisiamo__stat-number" data-counter="20" data-suffix="-30€">20-30€</div>
              <div class="chisiamo__stat-label">Prezzo medio a persona</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MENU ===== -->
  <section class="menu reveal" id="menu">
    <div class="container">
      <div class="section__header">
        <span class="section__eyebrow">Il Nostro Menu</span>
        <h2 class="section__title">La tradizione nel piatto</h2>
        <p class="section__subtitle">Piatti preparati al momento con ingredienti freschi e di stagione.</p>
      </div>
      <div class="menu__grid">
        <!-- Card in evidenza: piatto forte del locale (Carbonara al Tartufo, da GMaps) -->
        <div class="menu__card menu__card--featured">
          <span class="menu__card-badge">⭐ Più Richiesto</span>
          <div class="menu__card-icon">🍝</div>
          <h3 class="menu__card-title">Carbonara al Tartufo</h3>
          <p class="menu__card-desc">
            La nostra specialità più amata: pasta fresca, guanciale croccante, tartufo
            e la cremosità della vera carbonara romana.
          </p>
          <div class="menu__card-price">Il piatto più citato nelle recensioni</div>
        </div>

        <!-- Antipasti -->
        <div class="menu__card">
          <div class="menu__card-icon">🥗</div>
          <h3 class="menu__card-title">Antipasto della Casa</h3>
          <p class="menu__card-desc">
            Selezione di salumi, formaggi e specialità locali. L'inizio perfetto per ogni cena.
          </p>
          <div class="menu__card-price">Sempre fresco</div>
        </div>

        <!-- Specialità -->
        <div class="menu__card">
          <div class="menu__card-icon">🍕</div>
          <h3 class="menu__card-title">Crocchette &amp; Fritti</h3>
          <p class="menu__card-desc">
            Le nostre crocchette fatte in casa, tra i piatti più amati dai clienti.
          </p>
          <div class="menu__card-price">Fatti in casa</div>
        </div>

        <!-- Primi -->
        <div class="menu__card">
          <div class="menu__card-icon">🍜</div>
          <h3 class="menu__card-title">Primi della Tradizione</h3>
          <p class="menu__card-desc">
            Dalla carbonara alla gricia: i grandi classici romani preparati al momento.
          </p>
          <div class="menu__card-price">Ricette autentiche</div>
        </div>

        <!-- Dolci -->
        <div class="menu__card">
          <div class="menu__card-icon">🍰</div>
          <h3 class="menu__card-title">Dolci &amp; Dessert</h3>
          <p class="menu__card-desc">
            Il finale perfetto: tiramisù fatto in casa e dolci della tradizione.
          </p>
          <div class="menu__card-price">Fatti in casa</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GALLERIA ===== -->
  <section class="gallery reveal" id="galleria">
    <div class="container">
      <div class="section__header">
        <span class="section__eyebrow">Galleria</span>
        <h2 class="section__title">I nostri piatti</h2>
        <p class="section__subtitle">Uno sguardo a cosa ti aspetta. Clicca sulle foto per ingrandirle.</p>
      </div>
      <div class="gallery__grid">
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1612874742237-6526221588e3?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1612874742237-6526221588e3?w=600&q=85&auto=format&fit=crop" alt="Piatto di pasta" loading="lazy" />
        </div>
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1551218808-0e1e22c24f1b?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1551218808-0e1e22c24f1b?w=400&q=85&auto=format&fit=crop" alt="Piatto italiano" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1612874742237-6526221588e3?w=400&q=85&auto=format&fit=crop'" />
        </div>
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=400&q=85&auto=format&fit=crop" alt="Tavola imbandita" loading="lazy" />
        </div>
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1551183053-bf91a1d81141?w=400&q=85&auto=format&fit=crop" alt="Piatto italiano" loading="lazy" />
        </div>
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=600&q=85&auto=format&fit=crop" alt="Cucina italiana" loading="lazy" />
        </div>
        <div class="gallery__item" data-gallery="https://images.unsplash.com/photo-1546549032-9571cd6b27df?w=900&q=85&auto=format&fit=crop">
          <img src="https://images.unsplash.com/photo-1546549032-9571cd6b27df?w=400&q=85&auto=format&fit=crop" alt="Tagliata di manzo" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RECENSIONI ===== -->
  <section class="reviews reveal" id="recensioni">
    <div class="container">
      <div class="section__header">
        <span class="section__eyebrow">Recensioni</span>
        <h2 class="section__title">Cosa dicono i nostri clienti</h2>
        <p class="section__subtitle">La soddisfazione di chi è già passato a trovarci.</p>
      </div>
      <!-- RECENSIONI REALI da Google Maps (verificate) -->
      <div class="reviews__grid">
        <div class="review-card">
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">
            "Ho avuto il piacere di cenare in questo ristorante e l'esperienza è stata davvero eccellente. Il cibo è stato il vero protagonista della serata: ogni piatto era curato nei dettagli, con ingredienti di qualità e sapori ben equilibrati."
          </p>
          <div class="review-card__author">Claudia C. <span>— Google</span></div>
        </div>
        <div class="review-card">
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">
            "Simpatico il proprietario Maurizio che consiglia il piatto del giorno. Accoglienza con una buonissima bruschetta al pomodoro, offerta dal locale!"
          </p>
          <div class="review-card__author">Recensione Google <span>— Google</span></div>
        </div>
        <div class="review-card">
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">
            "Proprietari gentilissimi e simpatici, assolutamente consigliato. La carbonara al tartufo è da provare!"
          </p>
          <div class="review-card__author">Recensione Google <span>— Google</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA CENTRALE ===== -->
  <section class="cta-section reveal">
    <div class="container">
      <h2>Pronto a gustare?</h2>
      <p>Prenota il tuo tavolo direttamente su WhatsApp. Zero commissioni, zero intermediari. Ti rispondiamo in pochi minuti.</p>
      <div class="cta-section__buttons">
        <a href="https://wa.me/390652978474" target="_blank" rel="noopener" class="btn btn--whatsapp" style="font-size:1.05rem; padding:1rem 2.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white" style="display:block"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Prenota su WhatsApp
        </a>
        <a href="tel:+390652978474" class="btn btn--outline-light" style="border-color:rgba(255,255,255,0.5); color:white; font-size:1.05rem; padding:1rem 2.5rem;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white" style="display:block"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          Chiama 06 5297 8474
        </a>
      </div>
    </div>
  </section>

  <!-- ===== ORARI BANNER ===== -->
  <section class="instagram-banner reveal" style="background: linear-gradient(135deg, var(--color-secondary), #1A2A17);">
    <div class="container">
      <h3>Orari di apertura</h3>
      <p>Chiuso il lunedì · Mar–Ven 11:00–15:30 / 18:00–22:30 · Sab 11:30–15:30 / 18:30–22:30 · Dom 12:00–16:00</p>
      <a href="#contatti" class="btn btn--whatsapp" style="font-size:1rem; padding:0.875rem 2rem;">
        Prenota un tavolo
      </a>
    </div>
  </section>

  <!-- ===== MAPPA ===== -->
  <section class="map-section reveal" id="dovesiamo">
    <div id="map"></div>
    <div class="map__button">
      <a href="https://www.google.com/maps/dir/?api=1&destination=41.6814,12.7755" target="_blank" rel="noopener" class="btn btn--secondary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="display:block"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Portami lì — Apri navigatore
      </a>
    </div>
  </section>

  <!-- ===== CONTATTI ===== -->
  <section class="contacts reveal" id="contatti">
    <div class="container">
      <div class="section__header">
        <span class="section__eyebrow">Contatti</span>
        <h2 class="section__title">Prenota un tavolo</h2>
        <p class="section__subtitle">Scrivici su WhatsApp, chiamaci o compila il form. Ti rispondiamo subito.</p>
      </div>
      <div class="contacts__grid">
        <div class="contacts__info">
          <div class="contacts__item">
            <div class="contacts__item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#C9A96E" style="display:block"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
            <div>
              <div class="contacts__item-title">Indirizzo</div>
              <div class="contacts__item-text">Via del Mattatoio, 9<br>00049 Velletri RM</div>
            </div>
          </div>
          <div class="contacts__item">
            <div class="contacts__item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#C9A96E" style="display:block"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </div>
            <div>
              <div class="contacts__item-title">Telefono / WhatsApp</div>
              <div class="contacts__item-text"><a href="tel:+390652978474">06 5297 8474</a> · <a href="https://wa.me/390652978474" target="_blank" rel="noopener">WhatsApp</a></div>
            </div>
          </div>
          <div class="contacts__item">
            <div class="contacts__item-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#C9A96E" style="display:block"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </div>
            <div>
              <div class="contacts__item-title">Orari</div>
              <div class="contacts__item-text">
                <strong>Lunedì:</strong> Chiuso<br>
                <strong>Mar–Ven:</strong> 11:00–15:30 · 18:00–22:30<br>
                <strong>Sab:</strong> 11:30–15:30 · 18:30–22:30<br>
                <strong>Dom:</strong> 12:00–16:00
              </div>
            </div>
          </div>
        </div>
        <div class="contacts__form">
          <h3>Prenota un tavolo</h3>
          <form id="contactForm" data-wa="390652978474">
            <div class="form__group">
              <label class="form__label" for="name">Nome e Cognome *</label>
              <input class="form__input" type="text" id="name" name="name" required placeholder="Il tuo nome" />
            </div>
            <div class="form__group">
              <label class="form__label" for="phone">Telefono *</label>
              <input class="form__input" type="tel" id="phone" name="phone" required placeholder="Il tuo numero" />
            </div>
            <div class="form__group">
              <label class="form__label" for="guests">Numero persone</label>
              <select class="form__select" id="guests" name="guests">
                <option value="">Seleziona...</option>
                <option value="1">1 persona</option>
                <option value="2">2 persone</option>
                <option value="3">3 persone</option>
                <option value="4">4 persone</option>
                <option value="5">5 persone</option>
                <option value="6+">6+ persone</option>
              </select>
            </div>
            <div class="form__group" style="display:flex; gap:1rem;">
              <div style="flex:1;">
                <label class="form__label" for="date">Data</label>
                <input class="form__input" type="date" id="date" name="date" />
              </div>
              <div style="flex:1;">
                <label class="form__label" for="time">Orario</label>
